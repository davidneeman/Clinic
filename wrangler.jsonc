// Cloudflare settings for the website. The pages and files come from dist/ (built from
// public/ by scripts/build-cloudflare.mjs) and Cloudflare serves them by itself; the Worker
// in worker/ answers /api/*, serves the photos uploaded in the admin panel (/media/*), and
// puts David's content into the home and booking pages. Setup and deployment: worker/README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clinic",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-15",

  // Runs before `wrangler dev` and `wrangler deploy`.
  "build": {
    "command": "node scripts/build-cloudflare.mjs",
    "watch_dir": ["public", "config", "scripts", "worker", "server"]
  },

  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Only these reach the Worker: the API, the photos uploaded in the admin panel, and the
    // two pages his texts, photos and notices go into. The other files, the site's own
    // photos and the video are served straight from Cloudflare's cache, which is free and
    // doesn't count toward the daily request limit.
    "run_worker_first": ["/api/*", "/healthz", "/media/*", "/", "/book"]
  },

  // The bookings, closed days, opening hours and messages (made with
  // `wrangler d1 create clinic --jurisdiction eu`: the data stays in the EU).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clinic",
      "database_id": "10b4d26c-239c-41e4-b02f-645aaad9b70d",
      "migrations_dir": "migrations"
    }
  ],

  // The photos David uploads in the admin panel (worker/content.js), in Workers KV.
  "kv_namespaces": [{ "binding": "MEDIA", "id": "a199f2c60d3445b888c934c5bb9d2fbf" }],

  // Per visitor (by IP address): any API call, and sending a booking or a message.
  "ratelimits": [
    { "name": "API_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "FORMS_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],

  // Not secret. Everything else (Access, Grow, iCloud) is a secret instead:
  // `npx wrangler secret put …`, see worker/README.md.
  "vars": {
    // "transfer" (book on the site, pay by Bit or PayBox to David's phone, he approves),
    // "whatsapp" (requests by WhatsApp), "pay" (pay on the site through Grow) or "online"
    "BOOKING_MODE": "transfer",
    // Grow's test environment until the account is approved for real payments
    "GROW_ENV": "sandbox",
    // The calendar in his iCloud that bookings go into (made the first time if missing)
    "CALENDAR_NAME": "קליניקה"
  },

  // Every 10 minutes: ask Grow about payments it hasn't reported, release held times that
  // ran out, and retry bookings that didn't reach the calendar (and once a day, delete
  // uploaded photos that nothing on the site uses any more).
  "triggers": { "crons": ["*/10 * * * *"] },

  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false
}
