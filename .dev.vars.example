# Local settings for `npm run cf:dev`. Copy to .dev.vars (git ignores it).

# "whatsapp" hands bookings and messages to WhatsApp (as on the live site today); "pay" takes
# bookings with payment at Grow; "online" takes bookings and messages without payment.
BOOKING_MODE=online

# Cloudflare Access for the admin panel (worker/README.md). There's no Access locally, so
# the panel stays closed while these are empty.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
ADMIN_EMAILS=

# Grow's test identifiers, for BOOKING_MODE=pay (GROW_ENV in wrangler.jsonc is "sandbox").
GROW_USER_ID=
GROW_PAGE_CODE=

# The iCloud calendar: the Apple ID email and an app-specific password.
ICLOUD_USER=
ICLOUD_APP_PASSWORD=

# Signing in on the site (worker/README.md → "Signing in on the site"). Google's client ID and
# secret (its redirect URIs must include http://localhost:8787/api/auth/google/callback), and
# Twilio Verify for SMS codes. Locally, the *_URL settings can point to a stand-in on
# http://127.0.0.1:… instead (they're used only for requests to localhost).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE=
